name: Extrair ZIP
on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extrair o ZIP para a raiz do repositório
        run: |
          unzip -q AOSP-Modern-QS.zip -d /tmp/out
          rsync -a --exclude='.github' /tmp/out/AOSP-Modern-QS/ ./
          rm AOSP-Modern-QS.zip

      - name: Commit e push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Extrair AOSP-Modern-QS.zip"
          git push
